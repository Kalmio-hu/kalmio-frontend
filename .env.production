# Production build defaults (committed; no secrets here).
# Barion Pixel — LIVE pixel id. Public client-side identifier, not a secret.
# Local development pins the sandbox pixel (BPT-…) in .env.local.
VITE_BARION_PIXEL_ID=BP-CLnSC8PA8g-FB

# Purchase funnel (/app/premium, /app/founding-member) open in production builds; the
# PostHog flag payment_enabled stays the runtime kill switch.
VITE_PAYMENT_ENABLED=true

# Barion has not switched token (recurring) payment on yet: the Premium page says the card
# payment is awaiting approval. Remove this line once Barion confirms.
VITE_PAYMENT_PENDING_APPROVAL=true
